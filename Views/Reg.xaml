<Page x:Class="FinanceApp.Views.Reg"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FinanceApp.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" Background="White"
      Title="Reg">

    <Grid>

        <TextBlock Text="Создать аккаунт"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#71588a"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Center"
                   Margin="0,30,0,0"/>

        <Border Margin="50,100,50,50"
                CornerRadius="20"
                Padding="25">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#9e78c4" Offset="0"/>
                    <GradientStop Color="#7d6299" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="Логин" Foreground="White" FontSize="16" Margin="18,0,0,0"/>
                <TextBox x:Name="UsernameTextBox"
         Style="{StaticResource TextBox}"
         Margin="0,5,0,10"/>


                <!-- Email -->
                <TextBlock Text="Email" Foreground="White" FontSize="16" Margin="18,0,0,0"/>
                <TextBox x:Name="EmailTextBox"
         Style="{StaticResource TextBox}"
         Margin="0,5,0,10"/>


                <!-- Пароль -->
                <TextBlock Text="Пароль" Foreground="White" FontSize="16" Margin="18,0,0,0"/>
                <PasswordBox x:Name="PasswordBox"
             Style="{StaticResource PasswordBox}"
             Margin="0,5,0,10"/>


                <TextBlock Text="Подтвердите пароль" Foreground="White" FontSize="16" Margin="18,0,0,0"/>
                <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource PasswordBox}" Margin="0,5,0,20"/>
                <Button Content="Зарегистрироваться"
                        Height="40"
                        Background="#30FFFFFF"
                        Foreground="White"
                        BorderBrush="#40FFFFFF"
                        Click="RegisterButton_Click"
                        FontSize="16">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="20">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Content="Назад к входу" Height="35" Margin="0,10,0,0" Background="#10000000"
                    Foreground="White" BorderBrush="#40FFFFFF" Click="BackToLoginButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="20">
                                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>

        </Border>
    </Grid>
</Page>
