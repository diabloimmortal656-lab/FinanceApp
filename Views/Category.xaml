<Page x:Class="FinanceApp.Views.CategoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FinanceApp.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" Background="White"
      Title="Category">

    <Grid>

        <!-- ОСНОВНОЙ КОНТЕНТ -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <Border Background="#71588a" Height="70">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="FinanceApp • Категории"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource HeaderButtonStyle}" Content="Главная" Click="Home_Click"/>
                        <Button Style="{StaticResource HeaderButtonStyle}" Content="Транзакции" Click="Transaction_Click"/>
                        <Button Style="{StaticResource HeaderButtonStyle}" Content="Долги" Click="Debt_Click"/>
                        <Button Style="{StaticResource HeaderButtonStyle}" Content="Статистика" Click="Stats_Click"/>
                        <Button Style="{StaticResource HeaderButtonStyle}" Content="Категории"/>
                        <Button Style="{StaticResource HeaderButtonStyle}" Content="Профиль" Click="Profile_Click"/>
                        <Button Style="{StaticResource HeaderButtonStyle}" Content="Выйти из профиля" Foreground="Red" Click="Close"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Основная панель -->
            <Border Margin="20" CornerRadius="30" Padding="25" Grid.Row="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#9e78c4" Offset="0"/>
                        <GradientStop Color="#7d6299" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Доходы -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- HEADER -->
                        <Grid Margin="0,0,0,10">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Доходы"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="White"
                   VerticalAlignment="Center"/>

                            <Button Grid.Column="1"
                Content="Добавить"
                Width="120"
                Height="45"
                Background="#30FFFFFF"
                Foreground="White"
                BorderBrush="#40FFFFFF"
                Click="AddIncomeCategory">

                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="30">

                                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>

                            </Button>

                        </Grid>

                        <!-- LIST -->
                        <ListBox Grid.Row="1"
             x:Name="IncomeList"
             Background="Transparent"
             BorderThickness="0"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             SelectionMode="Single">

                            <ListBox.ItemContainerStyle>

                                <Style TargetType="ListBoxItem">

                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

                                    <EventSetter Event="MouseDoubleClick"
                             Handler="IncomeItem_DoubleClick"/>

                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="Transparent">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>

                                    <Style.Triggers>

                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="Transparent"/>
                                        </Trigger>

                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="Transparent"/>
                                        </Trigger>

                                    </Style.Triggers>

                                </Style>

                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>

                                <DataTemplate>

                                    <Border Padding="18"
                        CornerRadius="22"
                        Background="#30FFFFFF"
                        Margin="0,0,0,12">

                                        <Border.Style>

                                            <Style TargetType="Border">

                                                <Setter Property="Opacity" Value="1"/>

                                                <Style.Triggers>

                                                    <!-- системные -->
                                                    <DataTrigger Binding="{Binding System}" Value="1">
                                                        <Setter Property="Opacity" Value="0.45"/>
                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>

                                        </Border.Style>

                                        <Grid>

                                            <TextBlock Text="{Binding NameCategory}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="15"/>

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </ListBox.ItemTemplate>

                        </ListBox>

                    </Grid>

                    <!-- Расходы -->
                    <Grid Grid.Row="1" Margin="0,10,0,0">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- HEADER -->
                        <Grid Margin="0,0,0,10">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Расходы"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="White"
                   VerticalAlignment="Center"/>

                            <Button Grid.Column="1"
                Content="Добавить"
                Width="120"
                Height="45"
                Background="#30FFFFFF"
                Foreground="White"
                BorderBrush="#40FFFFFF"
                Click="AddExpenseCategory">

                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="30">

                                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>

                            </Button>

                        </Grid>

                        <!-- LIST -->
                        <ListBox Grid.Row="1"
             x:Name="ExpenseList"
             Background="Transparent"
             BorderThickness="0"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             SelectionMode="Single">

                            <ListBox.ItemContainerStyle>

                                <Style TargetType="ListBoxItem">

                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

                                    <EventSetter Event="MouseDoubleClick" Handler="ExpenseItem_DoubleClick"/>

                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="Transparent">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>

                                    <Style.Triggers>

                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="Transparent"/>
                                        </Trigger>

                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="Transparent"/>
                                        </Trigger>

                                    </Style.Triggers>

                                </Style>

                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>

                                <DataTemplate>

                                    <Border Padding="18"
                        CornerRadius="22"
                        Background="#30FFFFFF"
                        Margin="0,0,0,12">

                                        <Border.Style>

                                            <Style TargetType="Border">

                                                <Setter Property="Opacity" Value="1"/>

                                                <Style.Triggers>

                                                    <!-- системные -->
                                                    <DataTrigger Binding="{Binding System}" Value="1">
                                                        <Setter Property="Opacity" Value="0.45"/>
                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>

                                        </Border.Style>

                                        <Grid>

                                            <TextBlock Text="{Binding NameCategory}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="15"/>

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </ListBox.ItemTemplate>

                        </ListBox>

                    </Grid>

                </Grid>
            </Border>
        </Grid>

        <!-- 🔥 POPUP ПОВЕРХ ВСЕГО -->
        <Grid x:Name="CategoryPopupGrid" Grid.RowSpan="4"
              Background="#80000000"
              Visibility="Collapsed"
              Panel.ZIndex="999">

            <Border Width="350"
                    Padding="25"
                    CornerRadius="15"
                    Background="White"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>
                    <TextBlock x:Name="PopupTitle"
                               Text="Добавить категорию"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="Название"/>
                    <TextBox x:Name="txtPopupCategoryName"
                             Style="{StaticResource TextBoxPop}"
                             Margin="0,5,0,0"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,30,0,0">
                        <Button Content="Отмена"
                                Width="100"
                                Margin="0,0,0,0"
                                Click="CloseCategoryPopup" Foreground="#9176ad"
                                Style="{StaticResource HeaderButtonStyle}"/>

                        <Button Content="Сохранить"
                                Width="100"
                                Click="SaveCategoryPopup" Foreground="#5f4c73"
                                Style="{StaticResource HeaderButtonStyle}"/>
                    </StackPanel>

                    <Button x:Name="btnDeleteCategoryPopup" HorizontalContentAlignment="Center"
        Width="220"
        Height="40"
        Margin="0,20,0,0"
        Foreground="#C0392B"
        BorderThickness="0"
        Cursor="Hand"
        Click="DeleteCategoryPopup"
        HorizontalAlignment="Center">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border BorderBrush="#C0392B"
                    CornerRadius="20"
                    Padding="10">

                                    <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                                        <TextBlock Text="🗑"
                               FontSize="16"
                               Margin="0,0,8,0"/>

                                        <TextBlock Text="Удалить"
                               FontWeight="SemiBold"
                               FontSize="14"/>
                                    </StackPanel>
                                </Border>

                                <ControlTemplate.Triggers>

                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF5C5C"/>
                                    </Trigger>

                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#C0392B"/>
                                    </Trigger>

                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.5"/>
                                    </Trigger>

                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                </StackPanel>

            </Border>
        </Grid>

    </Grid>
</Page>
