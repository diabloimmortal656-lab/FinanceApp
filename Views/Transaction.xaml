<Page x:Class="FinanceApp.Views.Transactions"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FinanceApp.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" Background="White"
      Title="Transaction">

    <Grid>

        <!-- Разметка строк -->
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#71588a">

            <Grid Margin="20,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Название -->
                <TextBlock Text="FinanceApp • Транзакции"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <!-- Кнопки -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            >

                    <Button Style="{StaticResource HeaderButtonStyle}" Content="Главная" Click="Home_Click"/>
                    <Button Style="{StaticResource HeaderButtonStyle}" Content="Транзакции"/>
                    <Button Style="{StaticResource HeaderButtonStyle}" Content="Долги" Click="Debt_Click"/>
                    <Button Style="{StaticResource HeaderButtonStyle}" Content="Статистика" Click="Stats_Click"/>
                    <Button Style="{StaticResource HeaderButtonStyle}" Content="Категории" Click="CategoriesPage_Click"/>
                    <Button Style="{StaticResource HeaderButtonStyle}" Content="Профиль" Click="Profile_Click"/>
                    <Button Style="{StaticResource HeaderButtonStyle}" Content="Выйти из профиля" Foreground="Red" Click="Close"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- Основная область -->
        <Border Grid.Row="1"
                Margin="50,20,50,50"
                CornerRadius="30"
                Padding="25">

            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#9e78c4" Offset="0"/>
                    <GradientStop Color="#7d6299" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <TextBlock Text="Список транзакций"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,0,0,15"/>

                <!-- Таблица транзакций -->
                <ListBox Grid.Row="1"
         x:Name="dgTransactions"
         Background="Transparent"
         BorderThickness="0"
         ScrollViewer.VerticalScrollBarVisibility="Visible">

                    <!-- Убираем стандартный стиль -->
                    <ListBox.Resources>

                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,12"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

                            <Setter Property="Template">

                                <Setter.Value>

                                    <ControlTemplate TargetType="ListBoxItem">

                                        <Border Background="Transparent">
                                            <ContentPresenter/>
                                        </Border>

                                    </ControlTemplate>

                                </Setter.Value>

                            </Setter>

                        </Style>

                    </ListBox.Resources>

                    <!-- Карточки -->
                    <ListBox.ItemTemplate>

                        <DataTemplate>

                            <Border Padding="18"
                    CornerRadius="22"
                    Background="#30FFFFFF">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- LEFT -->
                                    <StackPanel Margin="50">

                                        <!-- CATEGORY -->
                                        <TextBlock Text="{Binding Category}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                                        <!-- DATE -->
                                        <TextBlock Text="{Binding Date, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}"
                                   Margin="0,6,0,0"
                                   FontSize="14"
                                   Foreground="#EAEAEA"/>

                                        <!-- NOTE -->
                                        <TextBlock Text="{Binding Note}"
                                   Margin="0,8,0,0"
                                   FontSize="15"
                                   TextWrapping="Wrap"
                                   Foreground="#F2F2F2"/>

                                    </StackPanel>

                                    <!-- RIGHT -->
                                    <StackPanel Grid.Column="1" Margin="70"
                                HorizontalAlignment="Right">

                                        <!-- AMOUNT -->
                                        <TextBlock Text="{Binding AmountText}" Foreground="{Binding AmountColor}"
           FontSize="24"
           FontWeight="Bold"
           HorizontalAlignment="Right">

                                        </TextBlock>

                                    </StackPanel>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ListBox.ItemTemplate>

                </ListBox>

            </Grid>

        </Border>

    </Grid>
</Page>
