<Page x:Class="FinanceApp.Views.Home"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FinanceApp.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" Background="White"
      Title="Home">

    <Grid>

        <!-- Разметка строк -->
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#71588a">

            <Grid Margin="20,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Название -->
                <TextBlock Text="FinanceApp • Главная"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <!-- Кнопки -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            >

                    <Button Style="{StaticResource HeaderButtonStyle}" Content="Главная" />
                    <Button Style="{StaticResource HeaderButtonStyle}" Content="Транзакции" Click="Transaction_Click"/>
                    <Button Style="{StaticResource HeaderButtonStyle}" Content="Долги" Click="Debt_Click"/>
                    <Button Style="{StaticResource HeaderButtonStyle}" Content="Статистика" Click="Stats_Click"/>
                    <Button Style="{StaticResource HeaderButtonStyle}" Content="Категории" Click="CategoriesPage_Click"/>
                    <Button Style="{StaticResource HeaderButtonStyle}" Content="Профиль" Click="Profile_Click"/>
                    <Button Style="{StaticResource HeaderButtonStyle}" Content="Выйти из профиля" Foreground="Red" Click="Close"/>


                </StackPanel>

            </Grid>

        </Border>


        <!-- Панель финансов -->
        <TextBlock Grid.Row="1"
                   x:Name="GreetingText"
                   FontSize="28"
                   FontWeight="Regular"
                   Margin="10,15,0,0"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Left"/>
        <Border Grid.Row="1"
                Margin="50,70,50,50"
                CornerRadius="30"
                Padding="25">

            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#9e78c4" Offset="0"/>
                    <GradientStop Color="#7d6299" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Баланс -->
                <StackPanel>
                    <TextBlock Text="Текущий баланс" 
                               Foreground="White"
                               FontSize="32"/>

                    <TextBlock x:Name="blnc" 
                               Foreground="White" 
                               FontSize="86"
                               FontWeight="Bold"
                               Margin="0,5,0,20"/>
                </StackPanel>

                <!-- Линия -->
                <Border Grid.Row="2"
                        Height="1"
                        Background="#40FFFFFF"
                        Margin="0,10"/>
                <TextBlock Grid.Row="2" Text="Доходы, расходы - за месяц" Foreground="White" Opacity="0.8" FontSize="28" Margin="0,50,0,0"/>
                <!-- Доходы и расходы -->
                <Grid Grid.Row="3" Margin="0,5,0,20">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="22*"/>
                        <ColumnDefinition Width="25*"/>
                    </Grid.ColumnDefinitions>


                    <StackPanel Grid.Column="0" Grid.ColumnSpan="2">

                        <TextBlock Text="Доходы" FontSize="28"
                                   Foreground="White"
                                   Opacity="0.8"/>
                        <TextBlock x:Name="IncomeText"
                                   
                                   FontSize="42"
                                   FontWeight="Bold"
                                   Foreground="#7CFFB2"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Left" Margin="366,0,0,0">
                        <TextBlock Text="Расходы" FontSize="28"
                                   Foreground="White"
                                   Opacity="0.8"/>
                        <TextBlock x:Name="ExpenseText"
                                   
                                   FontSize="42"
                                   FontWeight="Bold"
                                   Foreground="#FF9A9A"/>
                    </StackPanel>

                </Grid>

                <!-- Кнопки -->
                <Grid Grid.Row="4" Margin="0,20,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" FontSize="24"
                            Content="+ Доход"
                            Height="45"
                            Background="#30FFFFFF"
                            Foreground="White"
                            BorderBrush="#40FFFFFF"
                            Click="OpenIncomePopup">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
BorderBrush="{TemplateBinding BorderBrush}"
BorderThickness="1"
CornerRadius="30">
                                    <ContentPresenter HorizontalAlignment="Center"
              VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Column="2"
                            Content="- Расход" FontSize="24"
                            Height="45"
                            Background="#30FFFFFF"
                            Foreground="White"
                            BorderBrush="#40FFFFFF" Click="OpenExpensePopup">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="30">
                                    <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>


                </Grid>

            </Grid>
        </Border>

        <Grid x:Name="AddIncomePopup"
      Background="#80000000"
      Visibility="Collapsed"
      Panel.ZIndex="100"
      Grid.RowSpan="2">

            <Border 
            Padding="25"
            CornerRadius="15"
            Background="White"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

                <StackPanel>

                    <TextBlock x:Name="PopupTitle"
                       FontSize="22"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

                    <TextBlock Text="Сумма"/>
                    <TextBox x:Name="txtAmount" Style="{StaticResource TextBoxPop}"/>

                    <TextBlock Text="Категория"/>
                    <ComboBox x:Name="cbCategory"
          Width="280"
          Height="40"
          FontSize="16"
          FontFamily="Segoe UI"
          Background="White"
          BorderBrush="#E0E0E0"
          BorderThickness="2"
          Padding="8,6"
          DisplayMemberPath="NameCategory"
          SelectedValuePath="IDCategory">

                        <ComboBox.Template>
                            <ControlTemplate TargetType="ComboBox">
                                <Grid>
                                    <!-- Основной Border -->
                                    <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="20">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="30"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Выбранный элемент -->
                                            <ContentPresenter Grid.Column="0"
                  VerticalAlignment="Center"
                  Margin="10,0,0,0">
                                                <ContentPresenter.Content>
                                                    <Binding Path="SelectedItem.NameCategory"
                 RelativeSource="{RelativeSource TemplatedParent}"
                 TargetNullValue=""/>
                                                </ContentPresenter.Content>
                                            </ContentPresenter>


                                            <!-- Стрелка -->
                                            <TextBlock Grid.Column="1"
                                   Text="▼"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Foreground="#7A4FC3"/>
                                        </Grid>
                                    </Border>

                                    <!-- ToggleButton для открытия Popup -->
                                    <ToggleButton x:Name="toggleButton"
                              Grid.ColumnSpan="2"
                              Background="Transparent"
                              BorderBrush="{x:Null}"
                              IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                              Focusable="False"/>

                                    <!-- Выпадающий список -->
                                    <Popup x:Name="PART_Popup"
                       Placement="Bottom"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       AllowsTransparency="True"
                       Focusable="False"
                       PopupAnimation="Slide">
                                        <Border Background="White"
                            BorderBrush="#E0E0E0"
                            BorderThickness="2"
                            CornerRadius="20">
                                            <ScrollViewer Margin="0" SnapsToDevicePixels="True">
                                                <StackPanel IsItemsHost="True"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>
                                </Grid>

                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="BorderBrush" Value="#C8B6FF"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter TargetName="border" Property="BorderBrush" Value="#7A4FC3"/>
                                    </Trigger>
                                    <Trigger Property="IsDropDownOpen" Value="True">
                                        <Setter TargetName="border" Property="BorderBrush" Value="#7A4FC3"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ComboBox.Template>
                    </ComboBox>

                    <TextBlock Text="Описание"/>
                    <TextBox x:Name="txtDescription" Style="{StaticResource TextBoxPop}"/>

                    <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                        <Button Content="Отмена"
                        Width="90"
                        Margin="0,0,10,0"
                        Click="ClosePopup"
                        Foreground="#9176ad"        
                        Style="{StaticResource HeaderButtonStyle}"/>

                        <Button Content="Добавить"
                        Width="100"
                        Foreground="#5f4c73"        
                        Style="{StaticResource HeaderButtonStyle}"
                        Click="AddTranaction"/>

                    </StackPanel>

                </StackPanel>

            </Border>

        </Grid>
    </Grid>
</Page>
