<Page x:Class="FinanceApp.Views.DebtPage" 
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
      xmlns:sys="clr-namespace:System;assembly=mscorlib"      
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" mc:Ignorable="d" d:DesignHeight="450" 
      d:DesignWidth="800" Background="White" 
      Title="Debt">
    <Grid>

        <!-- ROWS -->
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#71588a">
            <Grid Margin="20,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="FinanceApp • Долги"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button Style="{StaticResource HeaderButtonStyle}" Content="Главная" Click="Home_Click"/>
                    <Button Style="{StaticResource HeaderButtonStyle}" Content="Транзакции" Click="Transaction_Click"/>
                    <Button Style="{StaticResource HeaderButtonStyle}" Content="Долги"/>
                    <Button Style="{StaticResource HeaderButtonStyle}" Content="Статистика" Click="Stats_Click"/>
                    <Button Style="{StaticResource HeaderButtonStyle}" Content="Категории" Click="CategoriesPage_Click"/>
                    <Button Style="{StaticResource HeaderButtonStyle}" Content="Профиль" Click="Profile_Click"/>
                    <Button Style="{StaticResource HeaderButtonStyle}" Content="Выйти из профиля" Foreground="Red" Click="Close"/>

                </StackPanel>

            </Grid>
        </Border>

        <!-- MAIN -->
        <Border Grid.Row="1"
                Margin="50,20,50,50"
                CornerRadius="30"
                Padding="25">

            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#9e78c4" Offset="0"/>
                    <GradientStop Color="#7d6299" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- BUTTONS -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">

                    <Button Content="Беру в долг"
                            Width="160"
                            Height="45"
                            Background="#30FFFFFF"
                            Foreground="White"
                            BorderThickness="1"
                            BorderBrush="#40FFFFFF"
                            Click="OpenAddDebtPopup"
                            Margin="0,0,15,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        CornerRadius="30">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Content="Даю в долг"
                            Width="160"
                            Height="45"
                            Background="#30FFFFFF"
                            Foreground="White"
                            BorderThickness="1"
                            BorderBrush="#40FFFFFF"
                            Click="OpenAddDebtPopup">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        CornerRadius="30">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                </StackPanel>

                <!-- LIST (как в Transactions) -->
                <ListBox Grid.Row="1"
                         x:Name="DebtList"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Visible">

                    <ListBox.Resources>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,12"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <EventSetter Event="MouseDoubleClick" Handler="DebtItem_DoubleClick"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.Resources>

                    <ListBox.ItemTemplate>
                        <DataTemplate>

                            <Border Padding="18"
                CornerRadius="22"
                Background="#30FFFFFF">

                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Opacity" Value="1"/>

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsClosed}" Value="True">
                                                <Setter Property="Opacity" Value="0.4"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- LEFT -->
                                    <StackPanel>

                                        <TextBlock Text="{Binding TypeDebt.NameTypeDebt}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"/>

                                        <TextBlock Text="{Binding NoteDebt}"
                               Margin="0,6,0,0"
                               FontSize="15"
                               Foreground="#F2F2F2"
                               TextWrapping="Wrap"/>

                                        <TextBlock Text="{Binding DateDebt, StringFormat={}{0:dd.MM.yyyy}}"
                               Margin="0,6,0,0"
                               FontSize="13"
                               Foreground="#DDDDDD"/>

                                    </StackPanel>

                                    <!-- RIGHT -->
                                    <StackPanel Grid.Column="1"
                            Margin="70,0,0,0"
                            HorizontalAlignment="Right">

                                        <TextBlock Text="{Binding AmountDebt, StringFormat={}{0:N0} ₽}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#FFB3B3"
                               HorizontalAlignment="Right"/>

                                        <TextBlock Text="{Binding PaidAmountDebt, StringFormat={}{0:N0} ₽}"
                               FontSize="16"
                               Foreground="#B7FFB7"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Right"/>

                                    </StackPanel>

                                    <!-- OVERLAY "ЗАКРЫТ" -->
                                    <TextBlock Text="ЗАКРЫТ"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False">

                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsClosed}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>

                                    </TextBlock>

                                </Grid>

                            </Border>

                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>

            </Grid>

        </Border>

        <!-- POPUP ADD -->
        <Grid x:Name="AddDebtPopup"
      Background="#80000000"
      Visibility="Collapsed"
      Panel.ZIndex="100"
      Grid.RowSpan="2">

            <Border Padding="25"
            CornerRadius="15"
            Background="White"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

                <StackPanel>

                    <TextBlock x:Name="PopupDebtTitle"
                       FontSize="22"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

                    <TextBlock Text="Сумма"/>
                    <TextBox x:Name="txtDebtAmount"
                     Style="{StaticResource TextBoxPop}"/>

                    <TextBlock Text="Описание"
                       Margin="0,10,0,0"/>
                    <TextBox x:Name="txtDebtNote"
                     Style="{StaticResource TextBoxPop}"/>

                    <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,15,0,0">

                        <Button Content="Отмена"
                        Width="90"
                        Margin="0,0,10,0"
                        Click="CloseAddDebtPopup"
                        Foreground="#9176ad"
                        Style="{StaticResource HeaderButtonStyle}"/>

                        <Button Content="Добавить"
                        Width="100"
                        Click="AddDebt"
                        Foreground="#5f4c73"
                        Style="{StaticResource HeaderButtonStyle}"/>

                    </StackPanel>

                </StackPanel>

            </Border>

        </Grid>

        <!-- POPUP PAY -->
        <Grid x:Name="PayDebtPopup"
      Background="#80000000"
      Visibility="Collapsed"
      Panel.ZIndex="100"
      Grid.RowSpan="2">

            <Border Padding="25"
            CornerRadius="15"
            Background="White"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

                <StackPanel>

                    <TextBlock x:Name="PayPopupTitle"
                       FontSize="22"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

                    <TextBlock Text="Сумма оплаты"/>

                    <TextBox x:Name="txtPayAmount"
                     Style="{StaticResource TextBoxPop}"/>

                    <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,15,0,0">

                        <Button Content="Отмена"
                        Width="90"
                        Margin="0,0,10,0"
                        Click="ClosePayPopup"
                        Foreground="#9176ad"
                        Style="{StaticResource HeaderButtonStyle}"/>

                        <Button Content="Сохранить"
                        Width="100"
                        Click="ApplyPayment"
                        Foreground="#5f4c73"
                        Style="{StaticResource HeaderButtonStyle}"/>

                    </StackPanel>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</Page>