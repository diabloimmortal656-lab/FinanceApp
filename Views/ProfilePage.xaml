<Page x:Class="FinanceApp.Views.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" d:DesignWidth="800"
      Background="White"
      Title="Profile">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Background="#71588a"
                Height="70">

            <Grid Margin="20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="FinanceApp • Профиль"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button Style="{StaticResource HeaderButtonStyle}"
                            Content="Главная" Click="Home_Click"/>

                    <Button Style="{StaticResource HeaderButtonStyle}"
                            Content="Транзакции" Click="Transaction_Click"/>

                    <Button Style="{StaticResource HeaderButtonStyle}"
                            Content="Долги" Click="Debt_Click"/>

                    <Button Style="{StaticResource HeaderButtonStyle}"
                            Content="Статистика" Click="Stats_Click"/>

                    <Button Style="{StaticResource HeaderButtonStyle}"
                            Content="Категории" Click="CategoriesPage_Click"/>

                    <Button Style="{StaticResource HeaderButtonStyle}"
                            Content="Профиль" />

                    <Button Style="{StaticResource HeaderButtonStyle}"
                            Content="Выйти из профиля"
                            Foreground="Red" Click="Close"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- CONTENT -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Hidden">

            <StackPanel Margin="20">

                <!-- USER BLOCK -->
                <Border CornerRadius="30"
                        Padding="30"
                        Margin="0,0,0,20">

                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="1,0">

                            <GradientStop Color="#9e78c4"
                                          Offset="0"/>

                            <GradientStop Color="#7d6299"
                                          Offset="1"/>

                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>

                        <!-- USER -->
                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="Текущий аккаунт"
                                       FontSize="17"
                                       Margin="0,10,0,0"
                                       Foreground="#E5E5E5"/>

                            <TextBlock x:Name="txtUserName"
                                       FontSize="36"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                            
                        </StackPanel>

                        <!-- OPERATIONS -->
                        <Border Grid.Column="1"
                                Width="180"
                                Height="180"
                                CornerRadius="30"
                                HorizontalAlignment="Right"
                                Background="#30FFFFFF"
                                BorderBrush="#40FFFFFF"
                                BorderThickness="1">

                            <StackPanel VerticalAlignment="Center">

                                <TextBlock x:Name="txtOperations"
                                           Text="248"
                                           FontSize="46"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="операций"
                                           FontSize="18"
                                           Foreground="#F1F1F1"
                                           HorizontalAlignment="Center"/>

                            </StackPanel>

                        </Border>

                    </Grid>

                </Border>

                <!-- SUMMARY -->
                <Grid Margin="0,0,0,20">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- BALANCE -->
                    <Border Height="170"
                            CornerRadius="30"
                            Padding="25"
                            Background="#9e78c4">

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="💰 Общий баланс"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock x:Name="txtBalance"
                                       Text="124 500 ₽"
                                       FontSize="34"
                                       Margin="0,25,0,0"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                        </StackPanel>

                    </Border>

                    <!-- INCOME -->
                    <Border Grid.Column="2"
                            Height="170"
                            CornerRadius="30"
                            Padding="25"
                            Background="#6fb86d">

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="📈 Общие доходы"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock x:Name="txtIncome"
                                       Text="+542 000 ₽"
                                       FontSize="34"
                                       Margin="0,25,0,0"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                        </StackPanel>

                    </Border>

                    <!-- EXPENSE -->
                    <Border Grid.Column="4"
                            Height="170"
                            CornerRadius="30"
                            Padding="25"
                            Background="#d66d6d">

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="📉 Общие расходы"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock x:Name="txtExpense"
                                       Text="-417 000 ₽"
                                       FontSize="34"
                                       Margin="0,25,0,0"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                        </StackPanel>

                    </Border>

                </Grid>

                <!-- LOWER -->
                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.7*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT SIDE -->
                    <StackPanel Grid.Column="0">

                        <!-- MONTH BLOCK -->
                        <Border CornerRadius="30"
                                Padding="25"
                                Margin="0,0,0,20">

                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0"
                                                     EndPoint="1,0">

                                    <GradientStop Color="#9e78c4"
                                                  Offset="0"/>

                                    <GradientStop Color="#7d6299"
                                                  Offset="1"/>

                                </LinearGradientBrush>
                            </Border.Background>

                            <StackPanel>

                                <TextBlock Text="Текущий месяц"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="White"/>

                                <!-- MONTH CARDS -->
                                <Grid Margin="0,25,0,20">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- MONTH INCOME -->
                                    <Border Grid.Column="0"
                                            Height="130"
                                            CornerRadius="25"
                                            Background="#35FFFFFF"
                                            Padding="20">

                                        <StackPanel>

                                            <TextBlock Text="Доходы"
                                                       FontSize="18"
                                                       Foreground="#E5E5E5"/>

                                            <TextBlock x:Name="txtMonthIncome"
                                                       Text="+45 000 ₽"
                                                       FontSize="28"
                                                       Margin="0,18,0,0"
                                                       FontWeight="Bold"
                                                       Foreground="White"/>

                                        </StackPanel>

                                    </Border>

                                    <!-- MONTH EXPENSE -->
                                    <Border Grid.Column="2"
                                            Height="130"
                                            CornerRadius="25"
                                            Background="#35FFFFFF"
                                            Padding="20">

                                        <StackPanel>

                                            <TextBlock Text="Расходы"
                                                       FontSize="18"
                                                       Foreground="#E5E5E5"/>

                                            <TextBlock x:Name="txtMonthExpense"
                                                       Text="-21 000 ₽"
                                                       FontSize="28"
                                                       Margin="0,18,0,0"
                                                       FontWeight="Bold"
                                                       Foreground="White"/>

                                        </StackPanel>

                                    </Border>

                                </Grid>

                                <!-- RESULT -->
                                <Border Height="120"
                                        CornerRadius="25"
                                        Background="#40FFFFFF"
                                        Padding="20">

                                    <StackPanel>

                                        <TextBlock Text="Итог месяца"
                                                   FontSize="18"
                                                   Foreground="#E5E5E5"/>

                                        <TextBlock x:Name="txtMonthResult"
                                                   Text="+24 000 ₽"
                                                   FontSize="38"
                                                   Margin="0,15,0,0"
                                                   FontWeight="Bold"
                                                   Foreground="White"/>

                                    </StackPanel>

                                </Border>

                            </StackPanel>

                        </Border>

                        <!-- FINANCIAL LEVEL -->
                        <Border Height="150"
                                CornerRadius="30"
                                Padding="25"
                                Background="#8a6ca9">

                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🏆 Финансовый уровень"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="White"/>
                                    <Button Content="?"
                                        Width="28"
                                        Height="28"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Background="#40FFFFFF"
                                        Foreground="White"
                                        FontWeight="Bold"
                                            Margin="10,3.3,0,0"
                                        BorderThickness="0" Style="{StaticResource RoundButton30}"
                                        Click="OpenFinanceInfo_Click"/>
                                </StackPanel>

                                <TextBlock Text="СТАБИЛЬНЫЙ" Name="txtFinancialLevel"
                                           FontSize="38"
                                           Margin="0,22,0,0"
                                           FontWeight="Light"
                                           HorizontalAlignment="Center"
                                           Foreground="#f2f2f2"/>

                            </StackPanel>

                        </Border>

                        <!-- FORECAST -->
                        <Border Height="190"
        CornerRadius="30"
        Padding="25"
        Margin="0,20,0,20"
        Background="#8b6aa8">

                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📅 Прогноз до конца месяца"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="White"/>
                                    <Button Content="?"
    Width="28"
    Height="28"
    HorizontalAlignment="Right"
    VerticalAlignment="Top"
    Background="#40FFFFFF"
    Foreground="White"
    FontWeight="Bold"
        Margin="10,3.3,0,0"
    BorderThickness="0" Style="{StaticResource RoundButton30}"
    Click="OpenForecastInfo_Click"/>
                                </StackPanel>
                                

                                <TextBlock Text="Если сохранять текущие траты:"
                   FontSize="16"
                   Margin="0,15,0,0"
                   Foreground="#ECECEC"/>

                                <!-- RESULT -->
                                <TextBlock x:Name="txtForecast"
                   Text="+12 450 ₽"
                   FontSize="42"
                   FontWeight="Bold"
                   Margin="0,20,0,0"
                   HorizontalAlignment="Center"
                   Foreground="#9CFFB1"/>

                                <!-- STATUS -->
                                <Border Margin="0,20,0,0"
                Padding="10"
                CornerRadius="15"
                Background="#25FFFFFF">

                                    <TextBlock x:Name="txtForecastStatus"
                       Text="Финансы под контролем"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>

                                </Border>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                    <!-- RIGHT SIDE -->
                    <StackPanel Grid.Column="2">

                        <!-- GOAL -->
                        <Border Height="203"
                                CornerRadius="30"
                                Padding="25"
                                Margin="0,0,0,20"
                                Background="#8d70ad">
                            <Grid>
                                <!--GOAL EMPTY-->
                                <StackPanel x:Name="GoalEmptyState"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

                                    <TextBlock Text="🎯 Цель не создана"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>

                                    <TextBlock Text="Создайте цель накоплений"
                       FontSize="18"
                       Margin="0,10,0,15"
                       Foreground="#EAEAEA"
                       HorizontalAlignment="Center"/>

                                    <Button Content="➕ Создать цель" FontSize="16" FontWeight="DemiBold" Style="{StaticResource RoundButton30}"
                    Width="250"
                    Height="42"
                    Background="#ffffff"
                    Foreground="#7d6299"
                    BorderThickness="0"
                    Click="OpenGoalPopup_Click"/>

                                </StackPanel>
                                <!--GOAL NO EMPTY-->
                                <Grid Visibility="Collapsed" Name="GoalContent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>

                                    <TextBlock Text="🎯 Цель накоплений" 
               FontSize="22"
               FontWeight="Bold"
               Foreground="White"/>


                                        <TextBlock Text="Игровой компьютер" Name="GoalTitleText"
               FontSize="20"
               Margin="0,20,0,0"
               Foreground="#F1F1F1"/>

                                        <TextBlock Text="45 000 ₽ / 120 000 ₽" Name="GoalAmountText"
               FontSize="30"
               Margin="0,15,0,0"
               FontWeight="Bold"
               Foreground="White"/>



                                </StackPanel>
                                    <ProgressBar Height="5" Grid.ColumnSpan="2"  Name="GoalOverlayProgress"
                                             Margin="0,150,0,0"
                                             Value="37"
                                             Maximum="100"/>
                                    <Button Grid.Column="1" Content="Управление целью" Width="120" Height="45" FontWeight="SemiBold" Click="OpenGoalEditPopup_Click" Style="{StaticResource RoundButton30}"
Background="#30FFFFFF"
Foreground="White"
BorderBrush="#40FFFFFF"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"/>
                                </Grid>
                            </Grid>
                            



                        </Border>

                        <!-- CATEGORY -->
                        <Border Height="161"
                                CornerRadius="30"
                                Padding="25"
                                Margin="0,0,0,20"
                                Background="#9e78c4">

                            <StackPanel>

                                <TextBlock Text="📊 Главная категория по тратам"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="White"/>

                                <TextBlock Text="Еда" Name="txtMainCategory"
                                           FontSize="34"
                                           Margin="0,10,0,0"
                                           FontWeight="Bold"
                                           Foreground="White"/>

                                <TextBlock Text="18 450 ₽ • 42%" Name="txtMainCategoryAmount"
                                           FontSize="18"
                                           Margin="0,5,0,0"
                                           Foreground="#ECECEC"/>

                            </StackPanel>

                        </Border>

                        <!-- LAST TRANSACTIONS -->
                       <Border CornerRadius="30"
        Padding="25"
        Background="#9e78c4"
        Height="360">

    <StackPanel>

        <TextBlock Text="Последние операции"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="White"/>

        <ItemsControl ItemsSource="{Binding LastTransactions}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>

                    <Border Margin="0,10,0,0"
                            Padding="12"
                            CornerRadius="15"
                            Background="#25FFFFFF">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding Title}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="White"/>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding AmountText}"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="{Binding AmountColor}"/>

                        </Grid>

                    </Border>

                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </StackPanel>

</Border>

                    </StackPanel>

                </Grid>

            </StackPanel>

        </ScrollViewer>
        <!-- OVERLAY -->
        <!-- FORECAST INFO POPUP -->
        <Grid x:Name="ForecastInfoOverlay" Grid.RowSpan="3"
      Visibility="Collapsed"
      Background="#80000000"
      Panel.ZIndex="2000">

            <Border Width="520"
            Padding="30"
            CornerRadius="30"
            Background="#8b6aa8"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

                <StackPanel>

                    <!-- HEADER -->
                    <Grid Margin="0,0,0,20">

                        <TextBlock Text="📅 Как считается прогноз"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="White"/>

                        <Button Content="✕" Style="{StaticResource RoundButton30}"
                        Width="34"
                        Height="34"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="#35FFFFFF"
                        Foreground="White"
                        BorderThickness="0"
                        Click="CloseForecastInfo_Click"/>
                    </Grid>

                    <!-- TEXT -->
                    <Border Background="#25FFFFFF"
                    CornerRadius="20"
                    Padding="18">

                        <StackPanel>

                            <!-- TITLE -->
                            <TextBlock Text="📊 Как считается прогноз"
               FontSize="18"
               FontWeight="Bold"
               Foreground="White"
               Margin="0,0,0,15"/>

                            <!-- BLOCK 1 -->
                            <Border Background="#25FFFFFF"
            CornerRadius="15"
            Padding="12"
            Margin="0,0,0,10">

                                <TextBlock TextWrapping="Wrap"
                   FontSize="14"
                   LineHeight="22"
                   Foreground="#F5F5F5"
                   Text="1. Берутся все доходы и расходы текущего месяца"/>
                            </Border>

                            <!-- BLOCK 2 -->
                            <Border Background="#25FFFFFF"
            CornerRadius="15"
            Padding="12"
            Margin="0,0,0,10">

                                <TextBlock TextWrapping="Wrap"
                   FontSize="14"
                   LineHeight="22"
                   Foreground="#F5F5F5"
                   Text="2. Считается средний дневной расход:
Расходы / количество прошедших дней"/>
                            </Border>

                            <!-- BLOCK 3 -->
                            <Border Background="#25FFFFFF"
            CornerRadius="15"
            Padding="12"
            Margin="0,0,0,10">

                                <TextBlock TextWrapping="Wrap"
                   FontSize="14"
                   LineHeight="22"
                   Foreground="#F5F5F5"
                   Text="3. Прогноз расходов:
текущие расходы + (средний дневной расход × оставшиеся дни)"/>
                            </Border>

                            <!-- BLOCK 4 -->
                            <Border Background="#25FFFFFF"
            CornerRadius="15"
            Padding="12"
            Margin="0,0,0,10">

                                <TextBlock TextWrapping="Wrap"
                   FontSize="14"
                   LineHeight="22"
                   Foreground="#F5F5F5"
                   Text="4. Итог:
Доходы - прогнозируемые расходы"/>
                            </Border>

                            <!-- RESULT NOTE -->
                            <Border Background="#35FFFFFF"
            CornerRadius="15"
            Padding="12"
            Margin="5,10,0,0">

                                <TextBlock TextWrapping="Wrap"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="White"
                   Text="📌 Положительный результат → бюджет стабилен
📌 Отрицательный результат → риск перерасхода"/>
                            </Border>

                        </StackPanel>
                    </Border>

                </StackPanel>

            </Border>

        </Grid>
        <Grid x:Name="GoalOverlay" Grid.RowSpan="4"
      Visibility="Collapsed"
      Background="#80000000"
      Panel.ZIndex="999">

            <!-- POPUP -->
            <Border Width="420"
            Padding="25"
            CornerRadius="25"
            Background="#8d70ad"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

                <StackPanel>

                    <Grid>

                        <TextBlock Text="🎯 Управление целью"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="White"/>
                        <Button Content="✕" Style="{StaticResource RoundButton30}"
                        Width="35"
                        Height="35"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Click="CloseGoalEditPopup_Click"
                        Background="#25FFFFFF"
                        Foreground="White"
                        BorderThickness="0"/>
                    </Grid>

                    <TextBox x:Name="GoalTitleBox" Width="auto"
         Text="Игровой компьютер"
         FontSize="20"
         Foreground="White"
         Background="Transparent"
         BorderThickness="0"
         IsReadOnly="True"/>

                    <StackPanel Orientation="Horizontal">

                        <!-- ВНЕСЕНО -->
                        <TextBlock x:Name="GoalPaidText" 
                                   FontSize="30" 
                                   FontWeight="Bold" 
                                   Foreground="White"/>

                        <TextBlock Text=" / "
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <!-- ЦЕЛЬ -->
                        <TextBox x:Name="GoalAmountBox" 
                                 Width="auto"
                                 FontSize="30"
                                 FontWeight="Bold"
                                 Foreground="White"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 IsReadOnly="True"/>

                        <TextBlock Text=" ₽"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                    </StackPanel>

                    <ProgressBar Height="5" Name="GoalOverlayProgressPopup"
                         Margin="0,15,0,0"
                         Value="37"
                         Maximum="100"/>

                    <!-- ACTIONS -->
                    <Grid Margin="0,25,0,0">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBox x:Name="txtGoalAddAmount" Style="{StaticResource TextBox}" Margin="0" TextAlignment="Left"
                                 Height="40"
                                 FontSize="16"
                                 Background="#35FFFFFF"
                                 Foreground="White"
                                 BorderThickness="0"/>
                        <Button Content="➕ Пополнить" Style="{StaticResource RoundButton30}"
                        Height="42"
                        Margin="0,10,0,10"
                        Background="#6fb86d"
                        Foreground="White"
                        BorderThickness="0"
                        Click="AddMoneyGoal_Click"/>
                        </StackPanel>
                        

                        <Button Grid.Row="1" Style="{StaticResource RoundButton30}" Name="btnEditGoal"
                        Content="✏ Изменить цель" Click="ToggleEditMode_Click"
                        Height="42"
                        Margin="0,0,0,10"
                        Background="#35FFFFFF"
                        Foreground="White"
                        BorderThickness="0"/>

                        <Button Grid.Row="2" Style="{StaticResource RoundButton30}"
                        Content="🗑 Удалить цель"
                        Height="42"
                        Background="#d66d6d"
                        Foreground="White"
                        BorderThickness="0"
                        Click="DeleteGoal_Click"/>

                    </Grid>

                </StackPanel>

            </Border>

        </Grid>
        <!-- CREATE GOAL POPUP -->
        <Grid x:Name="CreateGoalOverlay" Grid.RowSpan="2"
      Visibility="Hidden"
      Background="#80000000"
      Panel.ZIndex="1000">

            <Border Width="420"
            Padding="25"
            CornerRadius="30"
            Background="#8d70ad"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

                <StackPanel>

                    <!-- HEADER -->
                    <Grid>

                        <TextBlock Text="➕ Создание цели"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="White"/>

                        <Button Content="✕"
                        Width="35"
                        Height="35"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="#25FFFFFF"
                        Foreground="White"
                        BorderThickness="0"
                        Click="CloseGoalPopup_Click">

                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                    CornerRadius="30">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>

                        </Button>

                    </Grid>

                    <!-- NAME -->
                    <TextBlock Text="Название цели"
                       Margin="0,20,0,5"
                       Foreground="#EAEAEA"/>

                    <TextBox x:Name="txtGoalName" Style="{StaticResource TextBox}" TextAlignment="Left" FontSize="20"
                     Background="#35FFFFFF"
                     Foreground="White"
                     BorderThickness="0"/>

                    <!-- AMOUNT -->
                    <TextBlock Text="Сумма цели"
                       Margin="0,15,0,5"
                       Foreground="#EAEAEA"/>

                    <TextBox x:Name="txtGoalAmount" Style="{StaticResource TextBox}" TextAlignment="Left"
                     Background="#35FFFFFF"
                     Foreground="White"
                     BorderThickness="0"/>

                    <!-- BUTTON -->
                    <Button Content="Создать цель"
                    Height="45"
                    Margin="0,25,0,0"
                    Background="#ffffff"
                    Foreground="#7d6299"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Click="CreateGoalConfirm_Click"
                            Style="{StaticResource RoundButton30}"/>
                </StackPanel>

            </Border>

        </Grid>
        <!-- FINANCIAL INFO POPUP -->
        <ScrollViewer Grid.RowSpan="2" x:Name="FinanceInfoOverlayScroll"  Visibility="Collapsed">
            <Grid x:Name="FinanceInfoOverlay" Visibility="Collapsed"
      Background="#80000000" 
      Panel.ZIndex="2000">

            <Border Width="520"
            Padding="30"
            CornerRadius="30"
            Background="#8a6ca9"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

                <StackPanel>

                    <!-- HEADER -->
                    <Grid Margin="0,0,0,20">

                        <TextBlock Text="📊 Финансовый уровень"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="White"/>

                        <Button Content="✕" Style="{StaticResource RoundButton30}"
                        Width="34"
                        Height="34"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="#35FFFFFF"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Click="CloseFinanceInfo_Click"/>

                    </Grid>

                    <!-- DESCRIPTION -->
                    <Border Background="#25FFFFFF"
                    CornerRadius="20"
                    Padding="18"
                    Margin="0,0,0,20">

                        <TextBlock TextWrapping="Wrap"
                           FontSize="15"
                           LineHeight="28"
                           Foreground="#F5F5F5"
                           Text="
Финансовый уровень показывает не количество денег,
а качество управления финансами.

Система анализирует:
• доходы
• расходы
• остаток денег
• способность откладывать
• финансовую стабильность
"/>

                    </Border>

                    <!-- SCORES -->
                    <TextBlock Text="Основные показатели"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,15"/>

                    <!-- CASH FLOW -->
                    <Border Background="#25FFFFFF"
                    CornerRadius="18"
                    Padding="15"
                    Margin="0,0,0,12">

                        <StackPanel>

                                <TextBlock Text="💰 Cash Flow — 40%" Name="txtCashFlow"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                            <TextBlock Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               LineHeight="24"
                               FontSize="14"
                               Foreground="#ECECEC"
                               Text="Показывает: остаются ли у тебя деньги после всех трат.
"/>

                        </StackPanel>

                    </Border>

                    <!-- SAVINGS -->
                    <Border Background="#25FFFFFF"
                    CornerRadius="18"
                    Padding="15"
                    Margin="0,0,0,12">

                        <StackPanel>

                                <TextBlock Text="📈 Savings Rate — 30%" Name="txtSavingsRate"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                            <TextBlock Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               LineHeight="24"
                               FontSize="14"
                               Foreground="#ECECEC"
                               Text="Показывает: какую часть доходов ты сохраняешь.
"/>

                        </StackPanel>

                    </Border>

                    <!-- BUFFER -->
                    <Border Background="#25FFFFFF"
                    CornerRadius="18"
                    Padding="15"
                    Margin="0,0,0,20">

                            <StackPanel>

                                <TextBlock Text="🛡 Подушка безопасности — 30%" Name="txtFinancialBuffer"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                                <TextBlock Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               LineHeight="24"
                               FontSize="14"
                               Foreground="#ECECEC"
                               Text="Показывает: сколько месяцев можно прожить без дохода.
"/>

                            </StackPanel>
                        </Border>
                        <Border Background="#25FFFFFF"
                            CornerRadius="18"
                            Padding="15"
                            Margin="0,0,0,20">
                            
                            <TextBlock Text="Финальный счет" Name="txtFinanceScore"
                                FontSize="17"
                                FontWeight="SemiBold"
                                Foreground="White"/>
                        </Border>
                        <!-- LEVELS -->
                    <TextBlock Text="Уровни"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,15"/>

                    <Border Background="#25FFFFFF"
                    CornerRadius="20"
                    Padding="18">

                        <StackPanel>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                    <TextBlock Text="0 – 30" FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#FFB3B3"/>

                                    <TextBlock Grid.Column="1" FontSize="18"
                                   Text="Критический"
                                   Foreground="White"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                    <TextBlock Text="30 – 50" FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#FFD59E"/>

                                    <TextBlock Grid.Column="1" FontSize="18"
                                   Text="Низкий"
                                   Foreground="White"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                    <TextBlock Text="50 – 70" FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#FFF1A8"/>

                                    <TextBlock Grid.Column="1" FontSize="18"
                                   Text="Стабильный"
                                   Foreground="White"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                    <TextBlock Text="70 – 85" FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#B7FFB7"/>

                                    <TextBlock Grid.Column="1" FontSize="18"
                                   Text="Хороший"
                                   Foreground="White"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="85 – 100" FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#9CFFB1"/>

                                    <TextBlock Grid.Column="1" FontSize="18"
                                   Text="Отличный"
                                   Foreground="White"/>
                            </Grid>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </Border>

        </Grid>
        </ScrollViewer>
        
    </Grid>
</Page>
